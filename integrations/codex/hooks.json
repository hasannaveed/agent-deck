{
  "description": "Send privacy-preserving session lifecycle signals to Agent Switchboard.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "switchboardctl emit --harness codex",
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "switchboardctl emit --harness codex",
            "timeout": 1
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "switchboardctl emit --harness codex",
            "timeout": 1
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "request_user_input|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "switchboardctl emit --harness codex",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|request_user_input|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "switchboardctl emit --harness codex",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "switchboardctl emit --harness codex",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "switchboardctl emit --harness codex",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
